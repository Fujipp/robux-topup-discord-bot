# SlipOK Configuration (Bank Transfer / QR)
SLIPOK_BRANCH_ID=your_branch_id
API_SLIPOK_KEY=SLIPOK_xxxxxxxx

# TrueMoney Wallet Configuration
TRUEMONEY_PHONE=08xxxxxxxx
API_TRUEMONEY_KEY_ID=ak_live_xxxxxxxx
